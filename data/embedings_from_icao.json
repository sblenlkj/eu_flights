{
  "schema_version": "1.2",
  "updated_at": "2026-02-28",
  "entity": "aircraft_type_grouping",
  "normalization": {
    "typecode": "UPPERCASE(TRIM(typecode))",
    "model": "UPPERCASE(TRIM(model))",
    "fallback_group_id": "UNKNOWN_TYPE"
  },
  "preprocess_model_hint": [
    "Replace tabs with spaces",
    "Collapse repeated spaces",
    "Remove surrounding parentheses content like '(W)', '(WL)' if you want",
    "Keep hyphens but consider also creating a 'model_alnum' variant with only A-Z0-9 for robust matching"
  ],
  "matching_order": [
    "typecode_exact",
    "typecode_prefix",
    "model_contains",
    "fallback"
  ],
  "priority_rule": "Sort groups by priority DESC before matching (to avoid ACJ/A319 collisions, UC-35A collisions, etc.)",
  "groups": [
